            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"我家的小狗找到新家了\",\n  \"content\": \"经过一个月的等待，终于为小狗找到了合适的领养家庭\",\n  \"images\": [\"http://example.com/img1.jpg\"],\n  \"category\": \"领养故事\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/community/posts",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "community", "posts"]
