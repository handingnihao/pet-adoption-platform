              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/donations/my",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "donations", "my"]
            }
          }
        }
      ]
    },
    {
      "name": "健康检查",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/health",
          "host": ["{{base_url}}"],
          "path": ["health"]
        }
      }
    }
  ]
}
