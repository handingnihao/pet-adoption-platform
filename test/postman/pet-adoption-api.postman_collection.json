{
  "info": {
    "name": "爱心宠物领养平台API",
    "description": "宠物领养平台完整API测试集合",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "user_id",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "用户模块",
      "item": [
        {
          "name": "用户注册",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"状态码为200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"返回成功\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.code).to.eql(200);",
                  "    pm.collectionVariables.set(\"user_id\", jsonData.data.user_id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"testuser{{$randomInt}}\",\n  \"password\": \"Test@123456\",\n  \"phone\": \"138{{$randomInt}}{{$randomInt}}\",\n  \"email\": \"test{{$randomInt}}@example.com\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/users/register",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "users", "register"]
            }
          }
        },
        {
          "name": "用户登录",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"状态码为200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"返回token\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.code).to.eql(200);",
                  "    pm.expect(jsonData.data.token).to.be.a('string');",
                  "    pm.collectionVariables.set(\"token\", jsonData.data.token);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"testuser\",\n  \"password\": \"Test@123456\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/users/login",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "users", "login"]
            }
          }
        },
        {
          "name": "获取个人信息",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"状态码为200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"返回用户信息\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.code).to.eql(200);",
                  "    pm.expect(jsonData.data).to.have.property('username');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/users/profile",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "users", "profile"]
            }
          }
        },
        {
          "name": "更新个人信息",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"real_name\": \"张三\",\n  \"gender\": 1,\n  \"address\": \"北京市朝阳区\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/users/profile",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "users", "profile"]
            }
          }
        }
      ]
    },
    {
      "name": "宠物模块",
      "item": [
        {
          "name": "宠物列表",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"状态码为200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"返回列表数据\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.code).to.eql(200);",
                  "    pm.expect(jsonData.data).to.be.an('array');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/pets?page=1&page_size=10",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "pets"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "page_size",
                  "value": "10"
                }
              ]
            }
          }
        },
        {
          "name": "宠物详情",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/pets/1",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "pets", "1"]
            }
          }
        },
        {
          "name": "发布宠物",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"小白\",\n  \"type\": \"dog\",\n  \"breed\": \"金毛\",\n  \"gender\": \"male\",\n  \"age\": 12,\n  \"size\": \"large\",\n  \"color\": \"金色\",\n  \"weight\": 30.5,\n  \"is_vaccinated\": true,\n  \"is_sterilized\": false,\n  \"health_status\": \"健康\",\n  \"description\": \"性格温顺，喜欢和人玩耍\",\n  \"character\": \"活泼、友好\",\n  \"photos\": [\"http://example.com/photo1.jpg\"],\n  \"cover_photo\": \"http://example.com/cover.jpg\",\n  \"province\": \"北京市\",\n  \"city\": \"北京市\",\n  \"district\": \"朝阳区\",\n  \"address\": \"朝阳公园附近\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/pets",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "pets"]
            }
          }
        },
        {
          "name": "搜索宠物",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/pets/search?keyword=金毛",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "pets", "search"],
              "query": [
                {
                  "key": "keyword",
                  "value": "金毛"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "领养模块",
      "item": [
        {
          "name": "提交领养申请",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pet_id\": 1,\n  \"organization_id\": 1,\n  \"applicant_name\": \"张三\",\n  \"applicant_phone\": \"13800138000\",\n  \"applicant_address\": \"北京市朝阳区\",\n  \"housing_type\": \"house\",\n  \"housing_area\": 100,\n  \"has_yard\": true,\n  \"family_members\": 3,\n  \"has_children\": false,\n  \"family_agree\": true,\n  \"adoption_reason\": \"喜欢宠物，想给它一个温暖的家\",\n  \"how_to_care\": \"每天遛狗，定期体检\",\n  \"emergency_plan\": \"如遇紧急情况，会立即送往宠物医院\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/adoptions/applications",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "adoptions", "applications"]
            }
          }
        },
        {
          "name": "我的申请列表",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/adoptions/applications/my",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "adoptions", "applications", "my"]
            }
          }
        }
      ]
    },
    {
      "name": "社区模块",
      "item": [
        {
          "name": "发布动态",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
