{
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "宠物领养平台后端API接口文档\n\n测试账号：\n- 管理员: admin / Test@123456\n- 普通用户: testuser1 / Test@123456",
    "title": "宠物领养平台API",
    "version": "1.0.0"
  },
  "openapi": "3.0.0",
  "paths": {
    "/api/v1/users": {
      "get": {
        "description": "管理员获取用户列表（分页）",
        "parameters": [
          {
            "description": "页码",
            "in": "query",
            "name": "page",
            "schema": {
              "type": "integer"
            }
          },
          {
            "description": "每页数量",
            "in": "query",
            "name": "page_size",
            "schema": {
              "type": "integer"
            }
          },
          {
            "description": "角色筛选",
            "in": "query",
            "name": "role",
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "状态筛选",
            "in": "query",
            "name": "status",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "成功"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "获取用户列表",
        "tags": [
          "用户管理"
        ]
      }
    },
    "/api/v1/users/login": {
      "post": {
        "description": "用户名密码登录",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "password": {
                    "example": "Test@123456",
                    "type": "string"
                  },
                  "username": {
                    "example": "admin",
                    "type": "string"
                  }
                },
                "required": [
                  "username",
                  "password"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "登录成功"
          }
        },
        "summary": "用户登录",
        "tags": [
          "用户认证"
        ]
      }
    },
    "/api/v1/users/password": {
      "put": {
        "description": "修改当前用户密码",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "new_password": {
                    "type": "string"
                  },
                  "old_password": {
                    "type": "string"
                  }
                },
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "修改成功"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "修改密码",
        "tags": [
          "用户信息"
        ]
      }
    },
    "/api/v1/users/profile": {
      "get": {
        "description": "获取当前登录用户的个人信息",
        "responses": {
          "200": {
            "description": "成功"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "获取个人信息",
        "tags": [
          "用户信息"
        ]
      },
      "put": {
        "description": "更新当前登录用户的个人信息",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "avatar": {
                    "type": "string"
                  },
                  "gender": {
                    "enum": [
                      0,
                      1,
                      2
                    ],
                    "type": "integer"
                  },
                  "nickname": {
                    "type": "string"
                  },
                  "real_name": {
                    "type": "string"
                  }
                },
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "更新成功"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "更新个人信息",
        "tags": [
          "用户信息"
        ]
      }
    },
    "/api/v1/users/register": {
      "post": {
        "description": "新用户注册",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "code": {
                    "description": "验证码",
                    "type": "string"
                  },
                  "email": {
                    "type": "string"
                  },
                  "password": {
                    "type": "string"
                  },
                  "phone": {
                    "type": "string"
                  },
                  "username": {
                    "type": "string"
                  }
                },
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "注册成功"
          }
        },
        "summary": "用户注册",
        "tags": [
          "用户认证"
        ]
      }
    },
    "/api/v1/users/search": {
      "get": {
        "description": "管理员搜索用户",
        "parameters": [
          {
            "description": "搜索关键词",
            "in": "query",
            "name": "keyword",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "page",
            "schema": {
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "page_size",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "成功"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "搜索用户",
        "tags": [
          "用户管理"
        ]
      }
    },
    "/api/v1/users/send-code": {
      "post": {
        "description": "发送手机验证码",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "phone": {
                    "example": "13900000001",
                    "type": "string"
                  }
                },
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "发送成功"
          }
        },
        "summary": "发送验证码",
        "tags": [
          "用户认证"
        ]
      }
    },
    "/api/v1/users/{id}": {
      "get": {
        "description": "管理员获取指定用户详情",
        "parameters": [
          {
            "description": "用户ID",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "成功"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "获取用户详情",
        "tags": [
          "用户管理"
        ]
      }
    },
    "/api/v1/users/{id}/disable": {
      "put": {
        "description": "管理员禁用指定用户",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "禁用成功"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "禁用用户",
        "tags": [
          "用户管理"
        ]
      }
    },
    "/api/v1/users/{id}/enable": {
      "put": {
        "description": "管理员启用指定用户",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "启用成功"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "启用用户",
        "tags": [
          "用户管理"
        ]
      }
    },
    "/health": {
      "get": {
        "description": "检查服务器运行状态",
        "responses": {
          "200": {
            "description": "成功"
          }
        },
        "summary": "健康检查",
        "tags": [
          "系统"
        ]
      }
    }
  },
  "servers": [
    {
      "description": "本地开发环境",
      "url": "http://localhost:8080"
    },
    {
      "description": "测试服务器",
      "url": "http://115.190.125.177:8080"
    }
  ],
  "tags": [
    {
      "description": "系统健康检查",
      "name": "系统"
    },
    {
      "description": "用户登录、注册",
      "name": "用户认证"
    },
    {
      "description": "个人信息管理",
      "name": "用户信息"
    },
    {
      "description": "管理员功能",
      "name": "用户管理"
    }
  ]
}