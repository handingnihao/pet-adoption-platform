# MySQL 配置
MYSQL_ROOT_PASSWORD=your_root_password
MYSQL_DATABASE=pet_adoption
MYSQL_USER=pet_admin
MYSQL_PASSWORD=your_mysql_password

# Redis 配置
REDIS_PASSWORD=your_redis_password

# 应用配置
GIN_MODE=release
TZ=Asia/Shanghai

# 端口配置（如有冲突可修改）
MYSQL_PORT=3306
REDIS_PORT=6379
BACKEND_PORT=8080
FRONTEND_PORT=80
