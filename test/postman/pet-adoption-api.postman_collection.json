                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"organization_id\": 1,\n  \"amount\": 100.00,\n  \"payment_method\": \"alipay\",\n  \"donor_name\": \"张三\",\n  \"donor_phone\": \"13800138000\",\n  \"message\": \"希望能帮助更多流浪动物\",\n  \"is_anonymous\": false\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/donations",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "donations"]
